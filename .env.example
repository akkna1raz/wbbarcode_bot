# Токен бота Telegram для валидации X-Telegram-Init-Data (HMAC-SHA256)
TG_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Yandex Cloud Search API (поиск сниппетов по базам ean13, olegon, goodsmatrix и др.)
YANDEX_SEARCH_API_KEY=AQVNxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
YANDEX_FOLDER_ID=b1gxxxxxxxxxxxxxxxxx

# Yandex Foundation Models (YandexGPT для извлечения сущностей из сниппетов)
YANDEX_GPT_API_KEY=AQVNxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Подключение к Redis (Upstash, Redis Cloud или локальный) для кэширования и распределённых блокировок
REDIS_URL=rediss://default:password@your-redis-host:6379

# Опциональный прокси для обхода блокировок/rate-limit Wildberries (http://user:pass@host:port)
WB_PROXY_URL=